
DECLARE
    v_admin_id UUID := auth.uid();
    v_org_id BIGINT;
    v_assignment_id BIGINT;
BEGIN
    SELECT organization_id
    INTO v_org_id
    FROM public.profiles
    WHERE id = v_admin_id
      AND role = 'org_admin';

    IF v_org_id IS NULL THEN
        RAISE EXCEPTION 'Organization admin required'
            USING ERRCODE = '42501';
    END IF;

    -- Verify caretaker and patient roles and organization.
    IF (
        SELECT COUNT(*)
        FROM public.profiles
        WHERE (
            (id = p_caretaker_id AND role = 'caretaker')
            OR
            (id = p_patient_id AND role = 'patient')
        )
        AND organization_id = v_org_id
    ) <> 2 THEN
        RAISE EXCEPTION
            'Invalid caretaker or patient for organization'
            USING ERRCODE = '22023';
    END IF;

    -- Unique index prevents concurrent active assignments.
    INSERT INTO public.caretaker_assignments (
        organization_id,
        caretaker_id,
        patient_id,
        assigned_by,
        status
    )
    VALUES (
        v_org_id,
        p_caretaker_id,
        p_patient_id,
        v_admin_id,
        'active'
    )
    RETURNING id INTO v_assignment_id;

    RETURN v_assignment_id;

EXCEPTION
    WHEN unique_violation THEN
        RAISE EXCEPTION 'Patient already has an active caretaker'
            USING ERRCODE = '23505';
END;
